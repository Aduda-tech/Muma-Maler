# Release signing config — copy this to android/keystore.properties and fill in
# your values. NEVER commit the real android/keystore.properties (it is gitignored).
#
# storeFile is relative to the android/ directory.
# Example (keystore generated with keytool, kept at android/release.keystore):
storeFile=release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
